{
  "name": "aud_midi_web",
  "summary": "The browser backend of aud_midi, built on the Web MIDI API through package:web.",
  "domain": [
    "Browser MIDI backend"
  ],
  "interfaces": {
    "uses": {
      "aud_midi_core": "backend contracts",
      "aud_midi_standard": "models"
    },
    "usedBy": {
      "aud_midi": "consumes this package"
    }
  }
}
